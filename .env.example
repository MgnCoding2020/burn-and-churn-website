# Values read by the setup scripts in scripts/ (tenant, Stripe, database).
# Copy this file to .env and fill it in. .env is git-ignored: never commit it.
# Every value below is a placeholder, not a real identifier.

# --- Program hub ---
# Path to your local clone of grc-paper-project-coffee-shop. The tenant scripts read
# the staff roster (people.csv) and provisioning scripts from there.
HUB_PATH=../grc-paper-project-coffee-shop

# --- Microsoft Entra ID (staff tenant) ---
# Entra admin centre > Overview: "Tenant ID" and "Primary domain".
ENTRA_TENANT_ID=your-tenant-id
ENTRA_TENANT_DOMAIN=yourtenant.onmicrosoft.example
# Fictional domain shown in every committed document and evidence file.
BC_DOC_DOMAIN=burnandchurncoffee.com

# --- SharePoint (website content site) ---
# Filled in after the site is created (Business Premium trial phase).
SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.example/sites/your-site

# --- Stripe (TEST MODE ONLY) ---
# Stripe Dashboard > Developers > API keys, with "Test mode" switched on.
# Used only by scripts/stripe/setup-test.mjs to create the Terminal location,
# simulated reader and webhook endpoints. The script refuses any key that does
# not start with sk_test_.
STRIPE_SETUP_SECRET_KEY=sk_test_replace_me
