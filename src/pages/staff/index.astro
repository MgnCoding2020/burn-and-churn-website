---
import SessionTimeout from '../../components/staff/SessionTimeout.astro';
import StaffBar from '../../components/staff/StaffBar.astro';
import Base from '../../layouts/Base.astro';
import { screensFor, staffPageAccess, timeLeft } from '../../lib/staff-page';

// Rendered per request: it shows who is signed in.
export const prerender = false;

const access = staffPageAccess(Astro.locals.user, 'Staff.Barista');
if (!access.ok) return Astro.redirect(access.redirect, access.status);
const { user } = access;
Astro.response.headers.set('Cache-Control', 'no-store');

const BLURBS: Record<string, string> = {
  '/staff/register/': 'Ring up a counter order and take cash.',
  '/staff/orders/': 'Move orders from New to In progress to Ready.',
};
const screens = screensFor(user.role);
const { idleMsLeft, absoluteMsLeft } = timeLeft(user);
---

<Base title="Staff portal" description="Burn and Churn Coffee staff portal (fictional business).">
  <section class="container portal">
    <StaffBar name={user.displayName ?? 'Staff member'} role={user.role} current="/staff/" />
    <span class="eyebrow">Staff portal</span>
    <h1>Hello, {user.displayName ?? 'there'}</h1>
    <p class="lede">You're signed in with your Burn and Churn work account.</p>

    <ul class="launcher">
      {screens.map((s) => (
        <li>
          <a class="launcher__item" href={s.href}>
            <span class="launcher__title">{s.label}</span>
            <span class="launcher__blurb">{BLURBS[s.href]}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="portal__note">
      Signed-in sessions end after 8 hours, or after 1 hour without use (15 minutes once you've used
      the register or the order board). You'll get a warning two minutes before, with a button to
      stay signed in.
    </p>
  </section>
  <SessionTimeout idleMsLeft={idleMsLeft} absoluteMsLeft={absoluteMsLeft} />
</Base>

<style>
  .portal {
    max-width: 64rem;
  }
  .launcher {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--bc-space-4);
    margin: var(--bc-space-6) 0;
    padding: 0;
    list-style: none;
  }
  .launcher__item {
    display: flex;
    flex-direction: column;
    gap: var(--bc-space-2);
    min-height: 6rem;
    padding: var(--bc-space-6);
    background: var(--bc-surface);
    border: var(--bc-border-width) solid var(--bc-control-border);
    border-radius: var(--bc-radius-card);
    color: var(--bc-ink);
    text-decoration: none;
  }
  .launcher__item:hover {
    background: var(--bc-surface-hover);
  }
  .launcher__title {
    font-size: var(--bc-text-card-title);
    font-weight: 700;
  }
  .launcher__blurb {
    color: var(--bc-ink-muted);
  }
  .portal__note {
    color: var(--bc-ink-muted);
    font-size: 0.9375rem;
  }
</style>
