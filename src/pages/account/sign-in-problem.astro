---
import Base from '../../layouts/Base.astro';

export const prerender = true;
---

<Base title="Sign-in problem" description="Customer sign-in could not be completed.">
  <article class="container prose">
    <span class="eyebrow">Your account</span>
    <h1>We couldn't sign you in</h1>
    <p class="lede">
      The sign-in didn't complete. It may have taken longer than 10 minutes, been started in another
      tab, or been cancelled.
    </p>
    <p>
      <a class="btn btn--primary" href="/api/v1/auth/customer/login">
        Try again
      </a>
    </p>
  </article>
</Base>
