---
import Base from '../../layouts/Base.astro';
import { customerOrders } from '../../lib/checkout';
import { formatCents } from '../../lib/menu';

// Rendered per request: it shows who is signed in (plan §4.2, ADR-0042).
export const prerender = false;

const user = Astro.locals.user;
const customer = user?.idp === 'customer' ? user : undefined;
const staff = user?.idp === 'workforce';
const erasureReady = Astro.locals.erasureReady === true;
const db = Astro.locals.db;
const orders = customer && db ? await customerOrders(db, customer.id) : [];
const STAGE: Record<string, string> = {
  new: 'Paid, received',
  in_progress: 'Being made',
  ready: 'Ready at the counter',
  collected: 'Collected',
};
const day = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/New_York',
  month: 'short',
  day: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
});
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Base
  title="Your account"
  description="Burn and Churn Coffee customer account (fictional business)."
>
  <article class="container prose account">
    <span class="eyebrow">Your account</span>
    {customer ? (
      <>
        <h1>Hello, {customer.displayName ?? 'there'}</h1>
        <p class="lede">You're signed in with your Burn and Churn customer account.</p>
        <h2>What this site keeps about you</h2>
        <ul>
          <li>The name you gave when you signed up.</li>
          <li>
            Your account's ID in our customer directory, so we know it's you next time. Your email
            address stays in the directory; this site never stores it.
          </li>
          <li>One session cookie while you're signed in: 14 days at most, or 2 days unused.</li>
          <li>
            Your orders: the drinks, total, status and Stripe's payment ID, for 90 days. No card
            details: you pay on Stripe's own page.
          </li>
        </ul>
        <h2>Your orders</h2>
        {orders.length ? (
          <ul class="account__orders">
            {orders.map((o) => (
              <li>
                <a href={`/order/status/?id=${o.id}`}>Order #{o.orderNumber}</a>
                <span class="muted">
                  {day.format(o.createdAt)} · {formatCents(o.totalCents)} ·{' '}
                  {o.payment === 'refunded' ? 'Refunded' : STAGE[o.stage ?? 'new']}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p>
            No orders yet. <a href="/menu/">Browse the menu</a> to order ahead.
          </p>
        )}
        <h2>Your session</h2>
        <form method="post" action="/api/v1/auth/customer/logout">
          <button class="btn btn--secondary" type="submit">
            Sign out
          </button>
        </form>

        <h2>Delete your account</h2>
        {erasureReady ? (
          <form class="erase" method="post" action="/api/v1/account/delete">
            <p>
              This deletes your sign-in account from our customer directory and everything this site
              holds about you, straight away. It can't be undone; you can always create a new
              account later.
            </p>
            <label class="erase__confirm">
              <input type="checkbox" name="confirm" value="yes" required />I understand this can't
              be undone
            </label>
            <button class="btn btn--secondary" type="submit">
              Delete my account and data
            </button>
          </form>
        ) : (
          <p class="muted">Deleting accounts isn't set up in this environment yet.</p>
        )}
      </>
    ) : staff ? (
      <>
        <h1>Customer accounts are separate</h1>
        <p class="lede">
          You're signed in to the staff portal with a work account. Customer accounts live in a
          different directory, and a work account can't be used as one.
        </p>
        <p>
          <a class="btn btn--primary" href="/staff/">
            Back to the staff portal
          </a>
        </p>
      </>
    ) : (
      <>
        <h1>Sign in or create an account</h1>
        <p class="lede">
          No password: enter your email address and we'll send you a one-time code. New here? The
          same page lets you create an account.
        </p>
        <p>
          <a class="btn btn--primary" href="/api/v1/auth/customer/login">
            Continue with email
          </a>
        </p>
        <p class="muted">
          Burn and Churn Coffee is a fictional café, part of a security portfolio project. Sign-in
          is real, but nothing is sold: online ordering will be in test mode. We keep only your name
          and an account ID; see the <a href="/privacy/">privacy page</a>.
        </p>
      </>
    )}
  </article>
</Base>

<style>
  .account {
    max-width: 44rem;
  }
  .account__orders {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .account__orders li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--bc-space-1) var(--bc-space-3);
    padding: var(--bc-space-3) 0;
    border-top: var(--bc-border-width) solid var(--bc-border);
  }
  .erase {
    display: grid;
    gap: var(--bc-space-4);
    justify-items: start;
  }
  .erase p {
    margin: 0;
  }
  .erase__confirm {
    display: inline-flex;
    align-items: center;
    gap: var(--bc-space-2);
    min-height: var(--bc-tap-target);
  }
  .erase__confirm input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--bc-accent);
  }
</style>
