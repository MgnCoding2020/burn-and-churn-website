---
import CraftSection from '../components/home/CraftSection.astro';
import FeatureCards from '../components/home/FeatureCards.astro';
import HeroSection from '../components/home/HeroSection.astro';
import Announcements from '../components/shared/Announcements.astro';
import Base from '../layouts/Base.astro';
import {
  activeAnnouncements,
  hoursSummary,
  openNow,
  publishedHours,
  publishedMenu,
} from '../lib/published';

// Rendered per request (ADR-0045): opening hours and the featured drink's price
// come from what SharePoint published.
export const prerender = false;

const db = Astro.locals.db;
const [menu, hours, notices] = await Promise.all([
  publishedMenu(db),
  publishedHours(db),
  activeAnnouncements(db, 'public'),
]);
const featured = menu.items.find((i) => i.id === 'cream-cold-brew');
---

<Base
  title="Home"
  description="Burn and Churn Coffee: small-batch coffee from a fictional café. A security portfolio project; no real orders."
  flush
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset="/images/hero-espresso-640.webp 640w, /images/hero-espresso-720.webp 720w, /images/hero-espresso-960.webp 960w, /images/hero-espresso-1672.webp 1672w"
    imagesizes="(min-width: 48rem) 70vw, 100vw"
    fetchpriority="high"
  />
  <HeroSection />
  {notices.length > 0 && (
    <div class="container home-notices">
      <Announcements items={notices} />
    </div>
  )}
  <FeatureCards hours={hoursSummary(hours)} open={openNow(hours)} />
  <CraftSection featured={featured} />
</Base>

<style>
  .home-notices {
    margin-top: var(--bc-space-8);
  }
</style>
