---
import CraftSection from '../components/home/CraftSection.astro';
import FeatureCards from '../components/home/FeatureCards.astro';
import HeroSection from '../components/home/HeroSection.astro';
import Base from '../layouts/Base.astro';

export const prerender = true;
---

<Base
  title="Home"
  description="Burn and Churn Coffee: small-batch coffee from a fictional café. A security portfolio project; no real orders."
  flush
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset="/images/hero-espresso-640.webp 640w, /images/hero-espresso-720.webp 720w, /images/hero-espresso-960.webp 960w, /images/hero-espresso-1672.webp 1672w"
    imagesizes="(min-width: 48rem) 70vw, 100vw"
    fetchpriority="high"
  />
  <HeroSection />
  <FeatureCards />
  <CraftSection />
</Base>
