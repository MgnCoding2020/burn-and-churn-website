---
import Base from '../layouts/Base.astro';
import tokensCss from '../styles/tokens.css?raw';
import '../styles/styleguide.css';
import { CONTRAST_PAIRS, FORBIDDEN_PAIRS, contrastRatio, parseColourTokens } from '../lib/contrast';

export const prerender = true;

const colours = parseColourTokens(tokensCss);

const groups: Array<{ title: string; note: string; names: string[] }> = [
  {
    title: 'Surfaces',
    note: 'Page, bands, cards and the banner.',
    names: ['bg', 'bg-elevated', 'surface', 'surface-hover', 'banner-bg'],
  },
  {
    title: 'Text',
    note: 'Cream for reading; muted and subtle for secondary text.',
    names: ['ink', 'ink-muted', 'ink-subtle'],
  },
  {
    title: 'Accents',
    note: 'Bright orange for lines and page text; deeper orange for button fills.',
    names: ['accent', 'accent-text', 'action', 'action-hover', 'on-action', 'copper', 'gold'],
  },
  {
    title: 'Lines, focus and status',
    note: 'Decorative border vs control border; the focus ring; error and success text.',
    names: ['border', 'control-border', 'focus', 'danger', 'success'],
  },
];

const pairs = CONTRAST_PAIRS.map(([fg, bg, min, use]) => ({
  fg,
  bg,
  min,
  use,
  ratio: contrastRatio(colours[fg], colours[bg]),
}));

const forbidden = FORBIDDEN_PAIRS.map(([fg, bg, why]) => ({
  fg,
  bg,
  why,
  ratio: contrastRatio(colours[fg], colours[bg]),
}));

const spaces = [1, 2, 4, 6, 8, 12, 16];
---

<Base
  title="Styleguide"
  description="Burn and Churn Coffee design tokens and components (fictional business, portfolio project)."
>
  <div class="container">
    <span class="eyebrow">Design system</span>
    <h1>Styleguide</h1>
    <p class="lede">
      Every colour, type style and component the site uses, built from{' '}
      <code>src/styles/tokens.css</code>. The public site has one dark theme (ADR-0012). Contrast is
      checked against WCAG 2.2 AA on every build.
    </p>

    <section class="sg-section" aria-labelledby="sg-colour">
      <h2 id="sg-colour">Colour</h2>
      {groups.map((group) => (
        <>
          <h3>{group.title}</h3>
          <p class="muted">{group.note}</p>
          <ul class="sg-grid">
            {group.names.map((name) => (
              <li class="surface sg-swatch">
                <div class={`sg-swatch__chip sw-${name}`} />
                <div class="sg-swatch__body">
                  <strong>--bc-{name}</strong>
                  <br />
                  <code>{colours[name]}</code>
                </div>
              </li>
            ))}
          </ul>
        </>
      ))}
    </section>

    <section class="sg-section" aria-labelledby="sg-contrast">
      <h2 id="sg-contrast">Contrast</h2>
      <p class="muted">
        Text needs 4.5:1; large text, controls and focus rings need 3:1. The same list runs in CI (
        <code>npm run contrast</code>).
      </p>
      <div
        class="sg-scroll"
        role="region"
        aria-label="Contrast pairs in use (scrollable)"
        tabindex="0"
      >
        <table class="sg-table">
          <caption class="subtle">Pairs in use</caption>
          <thead>
            <tr>
              <th scope="col">Foreground</th>
              <th scope="col">Background</th>
              <th scope="col">Ratio</th>
              <th scope="col">Needs</th>
              <th scope="col">Result</th>
              <th scope="col">Used for</th>
            </tr>
          </thead>
          <tbody>
            {pairs.map((p) => (
              <tr>
                <td>
                  <code>{p.fg}</code>
                </td>
                <td>
                  <code>{p.bg}</code>
                </td>
                <td>{p.ratio.toFixed(2)}:1</td>
                <td>{p.min}:1</td>
                <td class={p.ratio >= p.min ? 'status--ok' : 'status--error'}>
                  {p.ratio >= p.min ? 'Pass' : 'Fail'}
                </td>
                <td>{p.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <h3>Never use</h3>
      <div
        class="sg-scroll"
        role="region"
        aria-label="Pairs never to use (scrollable)"
        tabindex="0"
      >
        <table class="sg-table">
          <thead>
            <tr>
              <th scope="col">Foreground</th>
              <th scope="col">Background</th>
              <th scope="col">Ratio</th>
              <th scope="col">Why</th>
            </tr>
          </thead>
          <tbody>
            {forbidden.map((p) => (
              <tr>
                <td>
                  <code>{p.fg}</code>
                </td>
                <td>
                  <code>{p.bg}</code>
                </td>
                <td>{p.ratio.toFixed(2)}:1</td>
                <td>{p.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sg-section" aria-labelledby="sg-type">
      <h2 id="sg-type">Type</h2>
      <div class="sg-type-sample">
        <p class="subtle">Display: DM Serif Display, hero headline</p>
        <p class="sg-display">
          Freshly Roasted.
          <br />
          <span class="sg-underline">Never Boring.</span>
        </p>
      </div>
      <div class="sg-type-sample">
        <p class="subtle">Section heading: DM Serif Display</p>
        <p class="sg-section-title">Coffee Done with Intention.</p>
      </div>
      <div class="sg-type-sample">
        <p class="subtle">Card heading: DM Serif Display</p>
        <p class="sg-card-title">Signature Drinks</p>
      </div>
      <div class="sg-type-sample">
        <p class="subtle">Eyebrow: Inter 700, uppercase, wide tracking</p>
        <span class="eyebrow">Our craft</span>
      </div>
      <div class="sg-type-sample">
        <p class="subtle">Body and lede: Inter</p>
        <p class="lede">
          Small-batch coffee, bold flavour, and a digital experience designed with care.
        </p>
        <p>
          From carefully sourced beans to a balanced pour, every detail is considered. Body text is
          set at 16–18px with a 1.55 line height for comfortable reading on a dark background.
        </p>
      </div>
      <div class="sg-type-sample">
        <p class="subtle">Prices: Inter, tabular figures</p>
        <p>
          <span class="price">$4.75</span> · <span class="price">$5.25</span> ·{' '}
          <span class="price">$5.75</span>
        </p>
      </div>
      <div class="sg-type-sample">
        <p class="subtle">Brand wordmark: Oswald (logo only)</p>
        <p class="brand-wordmark sg-brand">Burn &amp; Churn</p>
      </div>
    </section>

    <section class="sg-section" aria-labelledby="sg-components">
      <h2 id="sg-components">Components</h2>

      <h3>Buttons</h3>
      <div class="sg-row">
        <a class="btn btn--primary" href="#sg-components">
          Explore menu
        </a>
        <a class="btn btn--secondary" href="#sg-components">
          Our story
        </a>
        <span class="btn" role="link" aria-disabled="true">
          Order ahead · Demo: coming soon
        </span>
      </div>
      <p class="subtle">
        Primary uses <code>--bc-action</code> (5.37:1 with white), darkening on hover. Unavailable
        demo actions are dashed and say why in text.
      </p>

      <h3>Links</h3>
      <p>
        On the page: <a href="#sg-components">a text link</a>.
      </p>
      <div class="card">
        <p>
          On a card: <a href="#sg-components">View drinks →</a>
        </p>
      </div>

      <h3>Card</h3>
      <div class="sg-grid">
        <article class="card">
          <span class="eyebrow">Featured drink</span>
          <h4 class="sg-card-title">Cream Churn Cold Brew</h4>
          <p class="muted">Cold brew with a swirl of vanilla cream.</p>
          <p class="price">From $5.25</p>
        </article>
      </div>

      <h3>Category chips</h3>
      <nav aria-label="Example category navigation">
        <div class="sg-row">
          <a class="chip" href="#sg-components" aria-current="true">
            All coffee
          </a>
          <a class="chip" href="#sg-components">
            Espresso Bar
          </a>
          <a class="chip" href="#sg-components">
            Milk Drinks
          </a>
          <a class="chip" href="#sg-components">
            Cold Coffee
          </a>
        </div>
      </nav>
      <p class="subtle">The current chip is shown by fill and weight, not colour alone.</p>

      <h3>Status text</h3>
      <p class="status--error">
        Error: the menu couldn't be loaded. Showing the last published version.
      </p>
      <p class="status--ok">Saved: the change is published.</p>

      <h3>Focus</h3>
      <p class="muted">
        Press Tab to move through this page: every link, button and chip shows a 3px gold focus
        ring.
      </p>
    </section>

    <section class="sg-section" aria-labelledby="sg-space">
      <h2 id="sg-space">Spacing</h2>
      {spaces.map((n) => (
        <div class="sg-row">
          <code>--bc-space-{n}</code>
          <div class={`sg-space sg-space--${n}`} />
        </div>
      ))}
    </section>
  </div>
</Base>
