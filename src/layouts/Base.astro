---
import FictionBanner from '../components/shared/FictionBanner.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  /** Full-bleed first section (the homepage hero): no top padding on <main>. */
  flush?: boolean;
}

const {
  title,
  description = 'Burn and Churn Coffee, a fictional café: a security portfolio project.',
  flush = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#110d0b" />
    <link rel="icon" href="data:," />
    <link
      rel="preload"
      href="/fonts/inter-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-serif-display-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
    <title>{title} · Burn and Churn Coffee</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <FictionBanner />
    <SiteHeader />
    <main id="main" class:list={{ 'main--flush': flush }}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
