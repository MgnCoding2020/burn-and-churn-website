---
/**
 * Flame mark + wordmark. The flame is an original drawing (vector paths,
 * coloured by CSS); the words are real text so they scale and read aloud.
 */
interface Props {
  href?: string;
}
const { href = '/' } = Astro.props;
---

<a class="brand" href={href}>
  <svg class="brand__flame" viewBox="0 0 32 40" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M17.2 1.2c1.5 5.6-.9 9.1-3.9 12.5C10.1 17.3 6 21.1 6 27.2 6 33.7 10.6 39 16.6 39 22.6 39 27 34.1 27 28c0-4.6-2.2-8-4.6-10.8.2 3.3-.9 5.7-3 7 .7-6.3-.9-13.7-2.2-23Z"
    ></path>
    <path
      class="brand__flame-core"
      fill="currentColor"
      d="M16.7 22.4c.4 2.8-1.6 4.2-2.8 5.7-1 1.2-1.7 2.4-1.7 4 0 2.6 2 4.6 4.5 4.6s4.4-1.9 4.4-4.4c0-2.3-1.3-3.9-2.6-5.2.1 1.5-.4 2.6-1.4 3.2.3-2.8-.1-5.1-.4-7.9Z"
    ></path>
  </svg>
  <span class="brand__text">
    <span class="brand__name">Burn &amp; Churn</span>
    <span class="brand__sub">Coffee</span>
    <span class="visually-hidden">, home</span>
  </span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--bc-space-3);
    color: var(--bc-ink);
    text-decoration: none;
  }

  .brand__flame {
    width: 1.75rem;
    height: auto;
    color: var(--bc-accent);
  }

  .brand__flame-core {
    color: var(--bc-gold);
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .brand__name {
    font-family: var(--bc-font-brand);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    font-weight: 600;
    letter-spacing: var(--bc-tracking-brand);
    text-transform: uppercase;
  }

  .brand__sub {
    display: flex;
    align-items: center;
    gap: var(--bc-space-2);
    margin-top: var(--bc-space-1);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: var(--bc-ink-muted);
  }

  .brand__sub::before,
  .brand__sub::after {
    content: '';
    width: 1.25rem;
    height: 1px;
    background: var(--bc-copper);
  }
</style>
