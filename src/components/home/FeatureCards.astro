---
import { STORE_HOURS } from '../../data/store-hours';

const cards = [
  {
    title: 'Signature Drinks',
    body: 'House creations with big character.',
    href: '/menu/#signature-seasonal',
    cta: 'View drinks',
    image: '/images/signature-latte',
  },
  {
    title: 'Today’s Roast',
    body: 'Single-origin, freshly roasted in small batches.',
    href: '/menu/#brewed-coffee',
    cta: 'See this roast',
    image: '/images/todays-roast',
  },
];
---

<section class="container features" aria-label="Highlights">
  {cards.map((c) => (
    <article class="card feature">
      <picture class="feature__media">
        <source
          type="image/avif"
          srcset={`${c.image}-360.avif 360w, ${c.image}-720.avif 720w`}
          sizes="(min-width: 68.75rem) 12rem, 40vw"
        />
        <img
          src={`${c.image}-360.webp`}
          srcset={`${c.image}-360.webp 360w, ${c.image}-720.webp 720w`}
          sizes="(min-width: 68.75rem) 12rem, 40vw"
          width="360"
          height="270"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="feature__body">
        <h2 class="feature__title">{c.title}</h2>
        <p class="muted">{c.body}</p>
        <a class="feature__link" href={c.href}>
          {c.cta} <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>
  ))}

  <article class="card feature feature--hours" id="hours">
    <div class="feature__media feature__icon" aria-hidden="true">
      <svg viewBox="0 0 48 48" focusable="false">
        <circle
          cx="24"
          cy="24"
          r="17"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        ></circle>
        <path
          d="M24 14v11l7 5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
        ></path>
      </svg>
    </div>
    <div class="feature__body">
      <h2 class="feature__title">Café Hours</h2>
      <p>
        <strong>{STORE_HOURS.summary}</strong>
        <br />
        {STORE_HOURS.opens} – {STORE_HOURS.closes}
      </p>
      <p class="subtle">{STORE_HOURS.note}</p>
    </div>
  </article>
</section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--bc-space-5);
    margin-block: var(--bc-space-10) var(--bc-section-space);
  }

  .feature {
    display: grid;
    grid-template-columns: 45% minmax(0, 1fr);
    padding: 0;
    overflow: hidden;
    min-height: 11rem;
  }

  .feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature__icon {
    display: grid;
    place-items: center;
    background: var(--bc-bg-elevated);
    color: var(--bc-copper);
  }

  .feature__icon svg {
    width: 3.5rem;
  }

  .feature__body {
    padding: var(--bc-space-5);
    align-self: center;
  }

  .feature__body > :last-child {
    margin-bottom: 0;
  }

  .feature__title {
    margin-bottom: var(--bc-space-2);
    font-size: var(--bc-text-card-title);
    line-height: 1.1;
  }

  .feature__link {
    display: inline-flex;
    align-items: center;
    gap: var(--bc-space-2);
    min-height: var(--bc-tap-target);
    font-weight: 600;
    text-decoration: none;
  }

  .feature__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 68.74rem) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature--hours {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .features {
      grid-template-columns: 1fr;
    }

    .feature {
      grid-template-columns: 38% minmax(0, 1fr);
    }
  }
</style>
