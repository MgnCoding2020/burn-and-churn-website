---
import { formatCents, getMenuSnapshot, startingPrice } from '../../lib/menu';

// The featured drink comes from menu data, never hard-coded copy or prices.
const FEATURED_ID = 'cream-cold-brew';
const featured = getMenuSnapshot().items.find((i) => i.id === FEATURED_ID);
const from = featured ? startingPrice(featured) : undefined;

const tastingNotes = ['Dark chocolate', 'Toasted nut', 'Vanilla cream'];
---

<section class="container craft" id="story" aria-labelledby="craft-title">
  <div class="craft__copy">
    <span class="eyebrow">Our craft</span>
    <h2 id="craft-title">Coffee Done with Intention.</h2>
    <p class="lede">
      From carefully sourced beans to precise roasting and a balanced pour, we sweat the details
      that make a cup worth remembering.
    </p>
    <p class="subtle">
      Burn and Churn is a fictional café; the story is part of a portfolio project.
    </p>
  </div>

  <picture class="craft__media">
    <source
      type="image/avif"
      srcset="/images/cream-cold-brew-480.avif 480w, /images/cream-cold-brew-960.avif 960w, /images/cream-cold-brew-1122.avif 1122w"
      sizes="(min-width: 68.75rem) 30vw, (min-width: 48rem) 45vw, 100vw"
    />
    <img
      src="/images/cream-cold-brew-480.webp"
      srcset="/images/cream-cold-brew-480.webp 480w, /images/cream-cold-brew-960.webp 960w, /images/cream-cold-brew-1122.webp 1122w"
      sizes="(min-width: 68.75rem) 30vw, (min-width: 48rem) 45vw, 100vw"
      width="1122"
      height="1402"
      alt="An iced cold brew in a tall glass, with vanilla cream swirling through it."
      loading="lazy"
      decoding="async"
    />
  </picture>

  {featured && (
    <article class="card craft__featured" aria-labelledby="featured-title">
      <span class="eyebrow">Featured drink</span>
      <h3 id="featured-title">{featured.name}</h3>
      <p class="muted">{featured.description}.</p>
      {featured.available && from !== undefined ? (
        <p class="price craft__price">From {formatCents(from)}</p>
      ) : (
        <p class="status--error">Not available today.</p>
      )}
      <h4 class="craft__notes-title eyebrow">Tasting notes</h4>
      <ul class="craft__notes">
        {tastingNotes.map((n) => (
          <li>{n}</li>
        ))}
      </ul>
      <a class="feature-link" href={`/menu/#${featured.categoryId}`}>
        See it on the menu <span aria-hidden="true">→</span>
      </a>
    </article>
  )}
</section>

<style>
  /* Mockup layout: copy · cold-brew image · featured card. */
  .craft {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr) minmax(0, 1fr);
    grid-template-areas: 'copy media card';
    gap: var(--bc-space-8);
    align-items: center;
  }

  .craft__copy {
    grid-area: copy;
  }

  .craft__media {
    grid-area: media;
  }

  .craft__featured {
    grid-area: card;
  }

  .craft__media img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--bc-radius-card);
  }

  /* Tablet: copy beside the image, the card below spanning both. */
  @media (max-width: 68.74rem) {
    .craft {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'copy media'
        'card card';
    }
  }

  .craft__featured h3 {
    margin-bottom: var(--bc-space-3);
  }

  .craft__price {
    font-size: var(--bc-text-lg);
    color: var(--bc-gold);
  }

  .craft__notes-title {
    margin: var(--bc-space-6) 0 var(--bc-space-3);
    color: var(--bc-copper);
  }

  .craft__notes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--bc-space-2);
    margin: 0 0 var(--bc-space-6);
    padding: 0;
    list-style: none;
  }

  .craft__notes li {
    padding: var(--bc-space-1) var(--bc-space-3);
    border: var(--bc-border-width) solid var(--bc-control-border);
    border-radius: var(--bc-radius-pill);
    font-size: var(--bc-text-sm);
  }

  .feature-link {
    display: inline-flex;
    align-items: center;
    gap: var(--bc-space-2);
    min-height: var(--bc-tap-target);
    font-weight: 600;
    text-decoration: none;
  }

  .feature-link:hover {
    text-decoration: underline;
  }

  /* Phones: copy, image, card. */
  @media (max-width: 47.99rem) {
    .craft {
      grid-template-columns: 1fr;
      grid-template-areas:
        'copy'
        'media'
        'card';
      gap: var(--bc-space-8);
    }
  }
</style>
