---
import type { MenuCategory } from '../../lib/menu';

/**
 * Category navigation: plain anchor links (ADR-0013). Back, Forward and
 * shared links work with no JavaScript. Scrolls sideways on phones.
 */
interface Props {
  categories: MenuCategory[];
}
const { categories } = Astro.props;
---

<nav class="category-nav" aria-label="Menu categories">
  <ul class="container category-nav__list">
    {categories.map((c) => (
      <li>
        <a class="chip" href={`#${c.id}`}>
          {c.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .category-nav {
    border-bottom: var(--bc-border-width) solid var(--bc-border);
    background: var(--bc-bg);
  }

  .category-nav__list {
    display: flex;
    gap: var(--bc-space-3);
    margin: 0 auto;
    padding-block: var(--bc-space-4);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .category-nav__list li {
    flex: none;
    scroll-snap-align: start;
  }
</style>
