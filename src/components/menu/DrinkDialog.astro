---
import type { MenuItem } from '../../lib/menu';
import { priceCells } from '../../lib/menu/display';

/**
 * Drink detail as a native modal <dialog> (ADR-0013). Opened by the row's
 * button through invoker commands (command="show-modal"), so it needs no
 * JavaScript in current browsers; public/scripts/menu-dialog.js covers older
 * ones. The browser traps focus, closes on Escape and restores focus.
 * Each available size has an Add button for the online order
 * (src/scripts/menu-cart.ts); they stay disabled until that script runs.
 */
interface Props {
  item: MenuItem;
}
const { item } = Astro.props;
const cells = priceCells(item);
const id = `drink-${item.id}`;
---

<dialog class="drink-dialog" id={id} aria-labelledby={`${id}-title`}>
  <div class="drink-dialog__inner">
    <header class="drink-dialog__header">
      <h2 id={`${id}-title`}>{item.name}</h2>
      <button
        class="drink-dialog__close"
        type="button"
        command="close"
        commandfor={id}
        aria-label={`Close ${item.name}`}
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <p class="muted">{item.description}.</p>
    <p class:list={['drink-dialog__availability', item.available ? 'status--ok' : 'status--error']}>
      {item.available ? 'Available today' : 'Unavailable today'}
      {item.iced && item.available && ' · Served over ice'}
    </p>

    <h3 class="eyebrow drink-dialog__sizes-title">{cells.length === 1 ? 'Serving' : 'Sizes'}</h3>
    <ul class="drink-dialog__sizes">
      {cells.map((c) => (
        <li class:list={['drink-dialog__size', { 'drink-dialog__size--na': !c.available }]}>
          <span class="drink-dialog__size-label">{c.label}</span>
          <span class="price">{c.text}</span>
          {c.available && (
            <button
              class="btn btn--secondary drink-dialog__add"
              type="button"
              disabled
              data-cart-add
              data-item={item.id}
              data-variant={c.variantId}
              data-name={item.name}
              data-label={c.label}
              aria-label={`Add ${item.name}, ${c.label}, to your order`}
            >
              Add
            </button>
          )}
        </li>
      ))}
    </ul>

    <p class="drink-dialog__status" role="status" data-cart-status></p>
    <a class="btn btn--primary drink-dialog__order" href="/order/">
      View your order
    </a>
    <p class="subtle drink-dialog__note">
      Fictional drink and price. Orders are paid in Stripe test mode: no real money.
    </p>
  </div>
</dialog>

<style>
  .drink-dialog {
    width: min(100% - 2 * var(--bc-gutter), 28rem);
    max-height: min(90vh, 40rem);
    padding: 0;
    background: var(--bc-surface);
    border: var(--bc-border-width) solid var(--bc-control-border);
    border-radius: var(--bc-radius-card);
    color: var(--bc-ink);
  }

  .drink-dialog::backdrop {
    background: rgb(12 8 6 / 0.72);
  }

  .drink-dialog__inner {
    padding: var(--bc-space-6);
  }

  .drink-dialog__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--bc-space-4);
  }

  .drink-dialog__header h2 {
    margin: 0 0 var(--bc-space-3);
    font-size: var(--bc-text-card-title);
  }

  .drink-dialog__close {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--bc-tap-target);
    height: var(--bc-tap-target);
    margin: calc(var(--bc-space-2) * -1) calc(var(--bc-space-2) * -1) 0 0;
    background: none;
    border: var(--bc-border-width) solid var(--bc-control-border);
    border-radius: var(--bc-radius-button);
    color: var(--bc-ink);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .drink-dialog__availability {
    font-weight: 600;
  }

  .drink-dialog__sizes-title {
    margin: var(--bc-space-6) 0 var(--bc-space-2);
    color: var(--bc-accent-text);
  }

  .drink-dialog__sizes {
    margin: 0 0 var(--bc-space-6);
    padding: 0;
    list-style: none;
  }

  .drink-dialog__size {
    display: flex;
    align-items: center;
    gap: var(--bc-space-4);
    padding: var(--bc-space-3) 0;
    border-top: var(--bc-border-width) solid var(--bc-border);
  }

  .drink-dialog__size-label {
    flex: 1;
  }

  .drink-dialog__add {
    min-height: var(--bc-tap-target);
    padding-inline: var(--bc-space-4);
  }

  .drink-dialog__status {
    min-height: 1.5em;
    margin: 0 0 var(--bc-space-3);
    font-weight: 600;
  }

  .drink-dialog__size--na {
    color: var(--bc-ink-subtle);
  }

  .drink-dialog__order {
    width: 100%;
  }

  .drink-dialog__note {
    margin: var(--bc-space-3) 0 0;
  }

  /* Phones: a bottom sheet with safe-area padding. */
  @media (max-width: 47.99rem) {
    .drink-dialog {
      width: 100%;
      max-width: none;
      margin: auto 0 0;
      border-radius: var(--bc-radius-card) var(--bc-radius-card) 0 0;
    }

    .drink-dialog__inner {
      padding-bottom: calc(var(--bc-space-6) + env(safe-area-inset-bottom));
    }
  }
</style>
