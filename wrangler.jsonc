{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burn-and-churn-website",
  // Our Hono pipeline is the Worker entry, so it sees every request before
  // static assets are served (the adapter's default entry serves assets first).
  "main": "./src/fetch.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": true,
  // Every request, static files included, goes through the Worker first so the
  // security headers, request ID and test-mode guard apply to all responses.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  // Host logs keep request metadata but drop query strings, so one-time codes
  // (OIDC callbacks from Phase 2) never land in logs (ADR-0021).
  "observability": {
    "enabled": true,
    "redact_query_string": true,
  },
  // Hourly clean-up (ADR-0028) and the SharePoint sync every 15 minutes (ADR-0039), both in
  // src/server/scheduled.ts. The sync does nothing where Graph isn't set up.
  "triggers": {
    "crons": ["17 * * * *", "*/15 * * * *"],
  },
  // Rate limits per client IP, counted per Cloudflare location (src/lib/rate-limit.ts, ADR-0029).
  // Namespace IDs are this account's own numbering; previews use separate ones below.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "SIGNIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
  ],
  // Strict per-person limits on routes that cost something (src/lib/strict-limit.ts, ADR-0040):
  // one Durable Object per scope and caller, counting in memory (SQLite class, as the Free
  // plan requires; nothing is written to its storage).
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "RateLimiterDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiterDO"] }],
  // Non-secret settings. Secrets go in .dev.vars locally and `wrangler secret put` when deployed.
  "vars": {
    "APP_ENV": "production",
  },
  // Users, sessions, sign-in attempts and the audit log (ADR-0024, ADR-0027).
  // `wrangler dev` uses a local copy; migrations: `npx wrangler d1 migrations apply DB`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "burn-and-churn-website",
      "database_id": "2e5928e2-b207-4958-a418-c25d8ca7f979",
      "migrations_dir": "migrations",
    },
  ],
  // Preview deployments (`wrangler preview`, one per branch) get their own
  // settings and their own database, so they never present as production or
  // touch its data (ADR-0020). Previews get no sign-in secrets: their URLs
  // aren't registered in Entra, so staff sign-in there answers 503.
  "previews": {
    "vars": {
      "APP_ENV": "preview",
    },
    "ratelimits": [
      { "name": "API_LIMITER", "namespace_id": "1101", "simple": { "limit": 120, "period": 60 } },
      { "name": "SIGNIN_LIMITER", "namespace_id": "1102", "simple": { "limit": 20, "period": 60 } },
    ],
    // Declared again so previews get the binding (each preview has its own objects).
    "durable_objects": {
      "bindings": [{ "name": "LIMITER", "class_name": "RateLimiterDO" }],
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "burn-and-churn-website-preview",
        "database_id": "8f85680a-b290-4bb9-84dd-1e1271e46399",
        "migrations_dir": "migrations",
      },
    ],
  },
}
