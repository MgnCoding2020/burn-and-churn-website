{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burn-and-churn-website",
  // Our Hono pipeline is the Worker entry, so it sees every request before
  // static assets are served (the adapter's default entry serves assets first).
  "main": "./src/fetch.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": true,
  // Every request, static files included, goes through the Worker first so the
  // security headers, request ID and test-mode guard apply to all responses.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  // Host logs keep request metadata but drop query strings, so one-time codes
  // (OIDC callbacks from Phase 2) never land in logs (ADR-0021).
  "observability": {
    "enabled": true,
    "redact_query_string": true,
  },
  // Non-secret settings. Secrets go in .dev.vars locally and `wrangler secret put` when deployed.
  "vars": {
    "APP_ENV": "production",
  },
  // Preview deployments (`wrangler preview`, one per branch) get their own
  // settings, so they never present as production (ADR-0020). Preview-only
  // secrets and databases are added here from Phase 2.
  "previews": {
    "vars": {
      "APP_ENV": "preview",
    },
  },
}
