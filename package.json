{
  "name": "burn-and-churn-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Website, staff portal and counter register for Burn and Churn Coffee, a fictional café (security portfolio project, Stripe test mode only).",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typegen": "wrangler types",
    "typecheck": "npm run typegen && astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check-env": "node scripts/check-env.mjs",
    "check": "npm run check-env -- --ci && npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/cloudflare": "14.4.2",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "astro": "7.4.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "wrangler": "4.153.0"
  }
}
